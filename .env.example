# Kopieren nach .env (nicht versionieren!) und Werte eintragen.
# Wird von Compose automatisch gelesen: füllt sowohl ${...}-Platzhalter
# in docker-compose.yml als auch, wo per environment: durchgereicht,
# echte Umgebungsvariablen im app-Container.

# ---------- Ports auf dem Host ----------
API_PORT=9055
UI_PORT=9056

# ---------- Datenbank ----------
POSTGRES_DB=lukida_essential
POSTGRES_USER=lukida_essential
POSTGRES_PASSWORD=change-me-strong-password

# ---------- API (configs/application.ini) ----------
# einmalig erzeugen: openssl rand -hex 32
# wird automatisch sowohl in application.ini als auch im UI-Build (VITE_API_KEY)
# verwendet -- im Original-README zwei Stellen, hier nur noch eine.
LUKIDA_API_KEY=change-me-64-hex-zeichen
LUKIDA_STARTYEAR=2024
LUKIDA_AUTHOR_NAME=Max Mustermann
LUKIDA_AUTHOR_MAIL=admin@example.org
LUKIDA_AUTHOR_COMPANY=Musterbibliothek
LUKIDA_AUTHOR_HOMEPAGE=https://example.org

# ---------- SMTP (configs/production/user.ini) ----------
LUKIDA_SMTP_HOST=
LUKIDA_SMTP_FROM=noreply@example.org

# ---------- UI-Build (Vite, wird fest in ui/dist gebacken) ----------
VITE_APP_TITLE=Lukida Essentials Demo
VITE_API_CLIENT=Demo
